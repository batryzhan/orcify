ORCIFY_PROVIDER=mock
ORCIFY_ALLOW_PAID_PROVIDERS=false
# Local development values only. Use a secret manager and separate DB role in deployments.
DATABASE_URL=postgresql+psycopg://orcify:orcify-local-dev@localhost:5432/orcify
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=orcify-local-dev
POSTGRES_DB=orcify
POSTGRES_USER=orcify
POSTGRES_PASSWORD=orcify-local-dev
# API bearer credentials are generated by scripts/provision_api_identity.py, shown once,
# and stored as SHA-256 digests in PostgreSQL. Never put a bearer token in this file.
