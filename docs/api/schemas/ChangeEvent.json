{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "actor_id": {
      "title": "Actor Id",
      "type": "string"
    },
    "change_type": {
      "title": "Change Type",
      "type": "string"
    },
    "changed_fields": {
      "items": {
        "type": "string"
      },
      "title": "Changed Fields",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expected_snapshot_hash": {
      "title": "Expected Snapshot Hash",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "new_hash": {
      "title": "New Hash",
      "type": "string"
    },
    "new_version": {
      "title": "New Version",
      "type": "integer"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "old_hash": {
      "title": "Old Hash",
      "type": "string"
    },
    "old_version": {
      "title": "Old Version",
      "type": "integer"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "target_id": {
      "title": "Target Id",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "tenant_id",
    "project_id",
    "created_at",
    "target_id",
    "source_id",
    "actor_id",
    "change_type",
    "old_version",
    "new_version",
    "old_hash",
    "new_hash",
    "changed_fields",
    "occurred_at",
    "expected_snapshot_hash"
  ],
  "title": "ChangeEvent",
  "type": "object"
}
